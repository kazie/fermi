{
  "name": "fermi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fermi/server --filter @fermi/client dev",
    "dev:lan": "pnpm --parallel --filter @fermi/server --filter @fermi/client dev:lan",
    "build": "pnpm --filter @fermi/client build",
    "start": "node apps/server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p packages/shared && tsc -p apps/server && pnpm --filter @fermi/client type-check",
    "story:dev": "pnpm --filter @fermi/client story:dev",
    "story:build": "pnpm --filter @fermi/client story:build",
    "q": "node scripts/questions-cli.ts",
    "test:e2e": "playwright test",
    "test:e2e:video": "PW_VIDEO=1 FERMI_VOICE=1 playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test",
    "grow": "node scripts/grow.ts",
    "harvest": "node scripts/harvest.ts",
    "review": "node scripts/review-pool.ts",
    "voice:render": "node scripts/voice-render.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}

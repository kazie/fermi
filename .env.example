# Bearer token for the question admin API (pnpm q …, /fermi-questions). Required to add questions.
FERMI_ADMIN_TOKEN=change-me
# Where the SQLite database lives (default: ./data/fermi.db; /data/fermi.db in Docker)
# FERMI_DB=./data/fermi.db
# PORT=3000
# Where `pnpm q` sends requests (default http://localhost:3000)
# FERMI_SERVER=http://localhost:3000
# Behind a reverse proxy (nginx, Caddy, Fly…): trust X-Forwarded-For for per-client rate limits
# FERMI_TRUST_PROXY=1
